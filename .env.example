# Gameweek Edge — environment variables
# Copy this file to .env (never commit .env) and fill in real values.
# In production these are set in Netlify: Site settings → Build & deploy → Environment.

# ──────────────────────────────────────────────────────────────────────
# Anthropic API key — used by /.netlify/functions/ai for the AI panels
# (Decision Brief, Mini-League Story, Chip Advice, Confidence Feedback,
# Transfer Verdict). Never expose this in client code.
# Get from: https://console.anthropic.com/settings/keys
# ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE

# ──────────────────────────────────────────────────────────────────────
# Stripe (Phase 4 billing — not live yet)
# Required when the Pro paywall goes live and Checkout is enabled.
# Get from: https://dashboard.stripe.com/apikeys
# ──────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
STRIPE_PRICE_MONTHLY=YOUR_STRIPE_MONTHLY_PRICE_ID_HERE
STRIPE_PRICE_SEASON=YOUR_STRIPE_SEASON_PRICE_ID_HERE

# ──────────────────────────────────────────────────────────────────────
# Supabase (Phase 3 accounts — server-side webhook handler only)
# The browser uses the publishable key which is safe to expose; the
# service role key is server-side only.
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ──────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://knodunjnsxelmpziupwk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ──────────────────────────────────────────────────────────────────────
# Public site URL — used for Stripe Checkout redirects and Supabase auth
# email confirmation links. Set to your Netlify URL in production.
# ──────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://gameweek-edge.netlify.app
