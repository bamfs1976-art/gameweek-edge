# Gameweek Edge — environment for the data-integration (enrichment) layer.
#
# Copy to .env for local use. DO NOT COMMIT a real .env — it is gitignored.
# In production these live in the Netlify site environment, never in the repo
# and never in the browser: every credential below is read server-side only.
#
# WHAT IS LIVE TODAY, WITHOUT ANY OF THIS
# ---------------------------------------
# The layer works out of the box with NO credentials at all. Two providers
# need none from you:
#   official_fpl    keyless, via this site's existing /api/fpl proxy
#   football_data   uses FOOTBALL_DATA_KEY, already set for the existing
#                   /api/football-data proxy
# The other five are complete adapters that stay switched off until you fill
# in their settings below. Nothing about them has been verified against a live
# endpoint — see docs/ENRICHMENT.md.

# ── Generic behaviour ────────────────────────────────────────────────
FPL_DATA_TIMEOUT_SECONDS=15
FPL_DATA_CACHE_TTL_SECONDS=900
FPL_DATA_RETRY_ATTEMPTS=2
# Absolute origin used to reach this site's own proxies server-side.
# Netlify sets URL automatically, so you rarely need this.
# FPL_DATA_SELF_BASE_URL=https://gameweekedge.co.uk

# ── Premier League fixtures/results (LIVE via the existing proxy) ─────
# Defaults to this site's /api/football-data. Point elsewhere to swap provider.
# PREMIER_LEAGUE_API_BASE_URL=
# PREMIER_LEAGUE_API_KEY=
PREMIER_LEAGUE_COMPETITION=PL
PREMIER_LEAGUE_CACHE_TTL_SECONDS=3600

# ── LetLetMe FPL API (OPTIONAL — off until a base URL is set) ─────────
LETLETME_API_BASE_URL=
LETLETME_API_KEY=
# Paths are configurable because none of them is verified.
# LETLETME_PATH_PLAYERS=/players
# LETLETME_PATH_TEAMS=/teams
# LETLETME_PATH_FIXTURES=/fixtures

# ── Unofficial FPL GraphQL/REST wrapper (OPTIONAL) ────────────────────
FPL_GRAPHQL_API_URL=
FPL_GRAPHQL_API_KEY=
# graphql | rest — declared, never guessed from the URL.
FPL_GRAPHQL_MODE=graphql
# FPL_GRAPHQL_REST_PATH_PLAYERS=/players

# ── Apify: Live Football Data — injuries + predicted line-ups (OPTIONAL)
APIFY_TOKEN=
APIFY_LIVE_FOOTBALL_ACTOR_ID=
# dataset (read a prepared dataset, cheap) | run (start the actor and wait)
APIFY_LIVE_FOOTBALL_MODE=dataset
APIFY_LIVE_FOOTBALL_DATASET_ID=
# APIFY_LIVE_FOOTBALL_INPUT={"leagues":["premier-league"]}
APIFY_RUN_TIMEOUT_SECONDS=90
APIFY_CACHE_TTL_SECONDS=3600

# ── Apify: FPL Intelligence — third-party recommendations (OPTIONAL) ──
# Off by default. This is somebody else's model output, not a finding.
APIFY_FPL_INTELLIGENCE_ENABLED=false
APIFY_FPL_INTELLIGENCE_ACTOR_ID=
APIFY_FPL_INTELLIGENCE_MODE=dataset
APIFY_FPL_INTELLIGENCE_DATASET_ID=

# ── World News API — BBC/Sky/Guardian context (OPTIONAL) ──────────────
WORLD_NEWS_API_BASE_URL=
WORLD_NEWS_API_KEY=
WORLD_NEWS_SOURCES=bbc.co.uk,skysports.com,theguardian.com
WORLD_NEWS_LANGUAGE=en
WORLD_NEWS_COUNTRY=gb
WORLD_NEWS_WINDOW_DAYS=7
WORLD_NEWS_MAX_ARTICLES=20
