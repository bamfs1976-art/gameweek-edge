# Dependencies
node_modules/

# Capacitor web build output (regenerated by `npm run build:web`)
www/

# Daily content: per-run artefacts. history.json is deliberately NOT ignored —
# it is what stops the feed repeating itself between runs.
scripts/content/out/
scripts/content/content.json
scripts/content/threads/

# OS / editor
.DS_Store
*.log

# Full vaastav backtest dumps (pulled by dev/fetch-vaastav.mjs and
# scripts/history/fetch-seasons.mjs); the trimmed *.sample.csv fixtures ARE
# committed so the backtest runs offline, and so is the reduced artefact
# data/fpl-history.json — the ~45MB of source CSV behind it is not.
dev/fixtures/vaastav/**/merged_gw.csv
dev/fixtures/vaastav/**/players_raw.csv
dev/fixtures/vaastav/master_team_list.csv

# Video datasets and rendered output (regenerated by scripts/recap/*.mjs)
scripts/recap/*.json
scripts/recap/out/

# Raw sweep output from dev/fit-decay.mjs (regenerate rather than review in diffs).
dev/decay-fit-*.json
dev/fixtures/vaastav/**/players_raw.csv
